@{
    ViewData["Title"] = "Inicio";
}

<!-- Cabecera Directa -->
<div class="p-4 mb-4 text-white rounded-4 shadow-sm" style="background: linear-gradient(135deg, #0f172a 0%, #064e3b 100%);">
    <div class="container-fluid py-2">
        <div class="d-flex align-items-center mb-2">
            <div class="bg-white text-success rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px;">
                <i class="bi bi-shield-shaded fs-3 text-emerald"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">CrediPro</h3>
                <small class="text-white-50">Sistema de Evaluación y Gestión Crediticia</small>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="mt-3 pt-3 border-top border-white border-opacity-25 d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-white text-primary px-3 py-2 fs-6">
                    <i class="bi bi-person-fill me-1"></i> @User.Identity.Name
                </span>
                @if (User.IsInRole("Analista"))
                {
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                        <i class="bi bi-shield-check me-1"></i> Analista
                    </span>
                    <a asp-controller="Analista" asp-action="Index" class="btn btn-warning btn-sm fw-semibold px-3 ms-auto">
                        <i class="bi bi-shield-check me-1"></i> Ir al Panel de Analista
                    </a>
                }
                else
                {
                    <span class="badge bg-info text-dark px-3 py-2 fs-6">
                        <i class="bi bi-person me-1"></i> Cliente
                    </span>
                    <a asp-controller="Solicitudes" asp-action="MisSolicitudes" class="btn btn-light btn-sm text-primary fw-semibold px-3 ms-auto">
                        <i class="bi bi-card-checklist me-1"></i> Ver Mis Solicitudes
                    </a>
                }
            </div>
        }
        else
        {
            <div class="mt-3 pt-3 border-top border-white border-opacity-25">
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light text-primary fw-bold px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                </a>
            </div>
        }
    </div>
</div>

<!-- Opciones Funcionales -->
@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.IsInRole("Analista"))
    {
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                                <i class="bi bi-shield-check fs-3"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0">Panel de Evaluación</h5>
                                <small class="text-muted">Aprobar o rechazar créditos</small>
                            </div>
                        </div>
                        <p class="card-text text-secondary">
                            Revisa solicitudes pendientes con diagnóstico de regla 5X y resolución inmediata.
                        </p>
                        <a asp-controller="Analista" asp-action="Index" class="btn btn-outline-primary fw-semibold">
                            Entrar al Panel <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle me-3">
                                <i class="bi bi-bell fs-3"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0">Buzón de Notificaciones</h5>
                                <small class="text-muted">Historial de avisos</small>
                            </div>
                        </div>
                        <p class="card-text text-secondary">
                            Consulta la bitácora de mensajes y eventos procesados.
                        </p>
                        <a asp-controller="Solicitudes" asp-action="MisNotificaciones" class="btn btn-outline-info fw-semibold">
                            Ver Notificaciones <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                                <i class="bi bi-card-checklist fs-3"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0">Mis Solicitudes</h5>
                                <small class="text-muted">Historial de créditos</small>
                            </div>
                        </div>
                        <p class="card-text text-secondary">
                            Consulta el estado de tus solicitudes con filtros por monto y fechas.
                        </p>
                        <a asp-controller="Solicitudes" asp-action="MisSolicitudes" class="btn btn-outline-primary fw-semibold">
                            Ir a Mis Solicitudes <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle me-3">
                                <i class="bi bi-plus-circle fs-3"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0">Nueva Solicitud</h5>
                                <small class="text-muted">Pedir crédito</small>
                            </div>
                        </div>
                        <p class="card-text text-secondary">
                            Registra una nueva solicitud respetando el tope de 10 veces tus ingresos mensuales.
                        </p>
                        <a asp-controller="Solicitudes" asp-action="Crear" class="btn btn-outline-success fw-semibold">
                            Solicitar Crédito <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle me-3">
                                <i class="bi bi-bell fs-3"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0">Mis Notificaciones</h5>
                                <small class="text-muted">Avisos</small>
                            </div>
                        </div>
                        <p class="card-text text-secondary">
                            Revisa el buzón de notificaciones de tus solicitudes.
                        </p>
                        <a asp-controller="Solicitudes" asp-action="MisNotificaciones" class="btn btn-outline-info fw-semibold">
                            Ver Notificaciones <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- Credenciales de Prueba para Calificación -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-key-fill text-warning me-2"></i>Cuentas de Prueba
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Perfil</th>
                            <th>Correo</th>
                            <th>Contraseña</th>
                            <th>Ingresos</th>
                            <th class="text-end pe-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-warning text-dark"><i class="bi bi-shield-check"></i> Analista</span>
                            </td>
                            <td><code>analista@creditos.com</code></td>
                            <td><code>Password123!</code></td>
                            <td>Evaluador</td>
                            <td class="text-end pe-4">
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-outline-primary">
                                    Ingresar
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-primary"><i class="bi bi-person"></i> Cliente 1</span>
                            </td>
                            <td><code>cliente1@creditos.com</code></td>
                            <td><code>Password123!</code></td>
                            <td>$3,500.00</td>
                            <td class="text-end pe-4">
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-outline-primary">
                                    Ingresar
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-secondary"><i class="bi bi-person"></i> Cliente 2</span>
                            </td>
                            <td><code>cliente2@creditos.com</code></td>
                            <td><code>Password123!</code></td>
                            <td>$1,800.00</td>
                            <td class="text-end pe-4">
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-outline-primary">
                                    Ingresar
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
