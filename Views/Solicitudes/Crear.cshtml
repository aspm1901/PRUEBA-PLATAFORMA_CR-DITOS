@model PlataformaCreditos.Models.ViewModels.CrearSolicitudViewModel

@{
    ViewData["Title"] = "Registrar Nueva Solicitud de Crédito";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-file-earmark-plus"></i> Nueva Solicitud de Crédito</h4>
                </div>
                <div class="card-body p-4">
                    <!-- Feedback claro en la misma vista: Éxito -->
                    @if (!string.IsNullOrEmpty(Model.MensajeExito))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <h5 class="alert-heading"><i class="bi bi-check-circle-fill"></i> ¡Operación Exitosa!</h5>
                            <p class="mb-2">@Model.MensajeExito</p>
                            @if (Model.SolicitudIdCreada.HasValue)
                            {
                                <hr />
                                <div class="d-flex gap-2">
                                    <a asp-action="Detalle" asp-route-id="@Model.SolicitudIdCreada" class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-eye"></i> Ver Detalle de la Solicitud
                                    </a>
                                    <a asp-action="MisSolicitudes" class="btn btn-secondary btn-sm">
                                        <i class="bi bi-list-ul"></i> Ir al Listado de Solicitudes
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    <!-- Feedback claro en la misma vista: Error General -->
                    @if (!string.IsNullOrEmpty(Model.MensajeError))
                    {
                        <div class="alert alert-danger fade show" role="alert">
                            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Atención:</h5>
                            <p class="mb-0">@Model.MensajeError</p>
                        </div>
                    }

                    <!-- Errores de Validación de ModelState -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <h6 class="fw-bold"><i class="bi bi-shield-x"></i> Errores en la validación:</h6>
                            <ul class="mb-0">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    foreach (var error in modelState.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <!-- Resumen financiero del cliente -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body py-3">
                            <h6 class="text-uppercase text-muted fw-bold mb-2 small">Información de Capacidad de Crédito</h6>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <span class="text-muted d-block small">Tus Ingresos Mensuales:</span>
                                    <strong class="fs-6 text-dark">@Model.IngresosMensuales.ToString("C")</strong>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted d-block small">Monto Máximo Permitido (10x):</span>
                                    <strong class="fs-6 text-success">@Model.LimiteMaximo10X.ToString("C")</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.TieneSolicitudPendiente)
                    {
                        <div class="alert alert-warning mb-4" role="alert">
                            <i class="bi bi-info-circle-fill"></i> 
                            Tienes una solicitud activa en estado <strong>Pendiente</strong>. Por política institucional, no se pueden registrar nuevas solicitudes hasta que la actual sea resuelta.
                        </div>
                    }
                    else if (!Model.ClienteActivo)
                    {
                        <div class="alert alert-danger mb-4" role="alert">
                            <i class="bi bi-person-x-fill"></i> Tu cuenta de cliente se encuentra inactiva. Comunícate con administración.
                        </div>
                    }

                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="MontoSolicitado" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="MontoSolicitado" class="form-control form-control-lg" type="number" step="0.01" 
                                       placeholder="Ej: 15000.00" disabled="@(Model.TieneSolicitudPendiente || !Model.ClienteActivo)" />
                            </div>
                            <span asp-validation-for="MontoSolicitado" class="text-danger small"></span>
                            <div class="form-text">
                                El monto no puede superar 10 veces tus ingresos mensuales (@Model.LimiteMaximo10X.ToString("C")).
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">
                            <a asp-action="MisSolicitudes" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver a Mis Solicitudes
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-4" disabled="@(Model.TieneSolicitudPendiente || !Model.ClienteActivo)">
                                <i class="bi bi-send-check"></i> Registrar Solicitud
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
