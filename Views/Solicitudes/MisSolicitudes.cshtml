@model PlataformaCreditos.Models.ViewModels.MisSolicitudesViewModel

@{
    ViewData["Title"] = "Mis Solicitudes de Crédito";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            <i class="bi bi-wallet2 text-primary"></i> Mis Solicitudes de Crédito
        </h2>
        <div class="d-flex align-items-center gap-2">
            @if (Model.Cliente != null)
            {
                <span class="badge bg-info text-dark">
                    Ingresos: @Model.Cliente.IngresosMensuales.ToString("C")
                </span>
                <span class="badge @(Model.Cliente.Activo ? "bg-success" : "bg-danger")">
                    @(Model.Cliente.Activo ? "Activo" : "Inactivo")
                </span>
            }
            <a asp-action="Crear" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i> Nueva Solicitud
            </a>
        </div>
    </div>

    <!-- Contenedor dinámico de avisos en tiempo real -->
    <div id="ws-notification-container"></div>

    @if (ViewBag.InfoMessage != null)
    {
        <div class="alert alert-info" role="alert">
            @ViewBag.InfoMessage
        </div>
    }

    <!-- Alertas de validaciones Server-Side -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Error en los filtros:</h5>
            <ul class="mb-0">
                @foreach (var modelState in ViewData.ModelState.Values)
                {
                    foreach (var error in modelState.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }

    <!-- Filtros de búsqueda (Server-side) -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <strong><i class="bi bi-funnel"></i> Filtros de Búsqueda</strong>
        </div>
        <div class="card-body">
            <form asp-action="MisSolicitudes" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Estado:</label>
                    <select name="estado" class="form-select">
                        <option value="">-- Todos los estados --</option>
                        <option value="Pendiente" selected="@(Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Pendiente)">Pendiente</option>
                        <option value="Aprobado" selected="@(Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado)">Aprobado</option>
                        <option value="Rechazado" selected="@(Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Rechazado)">Rechazado</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Monto Mínimo:</label>
                    <input type="number" step="0.01" name="montoMin" value="@Model.MontoMin" class="form-control" placeholder="0.00" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Monto Máximo:</label>
                    <input type="number" step="0.01" name="montoMax" value="@Model.MontoMax" class="form-control" placeholder="0.00" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Desde:</label>
                    <input type="date" name="fechaInicio" value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hasta:</label>
                    <input type="date" name="fechaFin" value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <div class="btn-group w-100" role="group">
                        <button type="submit" class="btn btn-primary" title="Aplicar filtros">
                            Filtrar
                        </button>
                    </div>
                </div>
                <div class="col-12 text-end">
                    <a asp-action="MisSolicitudes" class="btn btn-outline-secondary btn-sm">Limpiar Filtros</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Listado de Solicitudes -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-secondary">Listado de Solicitudes (@Model.Solicitudes.Count)</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Solicitudes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th># Solicitud</th>
                                <th>Fecha Solicitud</th>
                                <th>Monto Solicitado</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="solicitudes-table-body">
                            @foreach (var item in Model.Solicitudes)
                            {
                                <tr id="solicitud-row-@item.Id">
                                    <td class="fw-bold">#@item.Id</td>
                                    <td>@item.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.MontoSolicitado.ToString("C")</td>
                                    <td>
                                        <span id="solicitud-badge-@item.Id" class="badge @(item.Estado == PlataformaCreditos.Models.EstadoSolicitud.Pendiente ? "bg-warning text-dark" : item.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado ? "bg-success" : "bg-danger")">
                                            @item.Estado.ToString()
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            Ver Detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-0">No se encontraron solicitudes que coincidan con los criterios de búsqueda.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const statusBadge = document.getElementById("ws-status-badge");
            const notificationContainer = document.getElementById("ws-notification-container");
            const lastSync = document.getElementById("ws-last-sync");

            // Configurar conexión SignalR forzando WebSocket como transporte
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/solicitudes", {
                    transport: signalR.HttpTransportType.WebSockets,
                    skipNegotiation: true
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .configureLogging(signalR.LogLevel.Information)
                .build();

            function setConnected() {
                if (statusBadge) {
                    statusBadge.className = "badge bg-success";
                    statusBadge.innerHTML = 'Conectado';
                }
                if (lastSync) {
                    lastSync.textContent = new Date().toLocaleTimeString();
                }
            }

            function setReconnecting() {
                if (statusBadge) {
                    statusBadge.className = "badge bg-warning text-dark";
                    statusBadge.innerHTML = 'Reconectando...';
                }
            }

            function setDisconnected() {
                if (statusBadge) {
                    statusBadge.className = "badge bg-danger";
                    statusBadge.innerHTML = 'Desconectado';
                }
            }

            // Manejadores del ciclo de vida de conexión
            connection.onreconnecting(() => {
                setReconnecting();
            });

            // Requerimiento: Al reconectar, consultar el estado vigente desde el servidor para recuperar cambios ocurridos
            connection.onreconnected(() => {
                setConnected();
                recuperarEstadosVigentes();
            });

            connection.onclose(() => {
                setDisconnected();
            });

            // Iniciar conexión WebSocket
            connection.start()
                .then(() => {
                    setConnected();
                    console.log(">>> [WebSocket] Conexión establecida con éxito en /hubs/solicitudes.");
                })
                .catch(err => {
                    console.error(">>> [WebSocket] Error al conectar:", err);
                    setDisconnected();
                });

            // Requerimiento: Recibir evento SolicitudEstadoActualizado y actualizar UI sin recargar la página
            connection.on("SolicitudEstadoActualizado", function (data) {
                console.log(">>> [WebSocket Event Received]:", data);

                const alertType = data.estado === "Aprobado" ? "success" : "danger";
                const icon = data.estado === "Aprobado" ? "check-circle-fill" : "x-circle-fill";

                // 1. Mostrar aviso en tiempo real sin recargar página
                const alertHtml = `
                    <div class="alert alert-${alertType} alert-dismissible fade show shadow-sm mb-3" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-${icon} fs-4 me-2"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Actualización de Solicitud</h6>
                                <div>Tu solicitud de crédito <strong>#${data.solicitudId}</strong> ha sido evaluada: 
                                    <span class="badge bg-${alertType} ms-1">${data.estado}</span>
                                </div>
                                ${data.motivoRechazo ? `<small class="d-block mt-1"><strong>Motivo:</strong> ${data.motivoRechazo}</small>` : ''}
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>`;

                notificationContainer.insertAdjacentHTML("afterbegin", alertHtml);

                // 2. Actualizar el estado visual del renglón en la tabla sin recargar página
                const badge = document.getElementById(`solicitud-badge-${data.solicitudId}`);
                const row = document.getElementById(`solicitud-row-${data.solicitudId}`);

                if (badge) {
                    badge.className = `badge bg-${alertType}`;
                    badge.textContent = data.estado;
                }

                if (row) {
                    row.classList.add("table-warning");
                    setTimeout(() => {
                        row.classList.remove("table-warning");
                    }, 3000);
                }
            });

            // Función para sincronizar estados si hubo desconexión temporal
            function recuperarEstadosVigentes() {
                fetch("/Solicitudes/ObtenerEstadosVigentes")
                    .then(response => response.json())
                    .then(data => {
                        if (Array.isArray(data)) {
                            data.forEach(item => {
                                const badge = document.getElementById(`solicitud-badge-${item.id}`);
                                if (badge) {
                                    const alertType = item.estado === "Aprobado" ? "bg-success" : item.estado === "Rechazado" ? "bg-danger" : "bg-warning text-dark";
                                    badge.className = `badge ${alertType}`;
                                    badge.textContent = item.estado;
                                }
                            });
                            lastSync.textContent = "Sincronizado tras reconexión: " + new Date().toLocaleTimeString();
                        }
                    })
                    .catch(err => console.error("Error al sincronizar estados vigentes:", err));
            }
        });
    </script>
}
