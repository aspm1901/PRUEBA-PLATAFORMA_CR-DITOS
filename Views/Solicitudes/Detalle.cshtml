@model PlataformaCreditos.Models.SolicitudCredito

@{
    ViewData["Title"] = $"Detalle de Solicitud #{Model.Id}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Contenedor dinámico de alertas de actualización en tiempo real -->
            <div id="ws-detalle-notification"></div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <h4 class="mb-0"><i class="bi bi-file-earmark-text"></i> Detalle de Solicitud #@Model.Id</h4>
                    <div>
                        <span id="detalle-estado-badge" class="badge @(Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Pendiente ? "bg-warning text-dark" : Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Aprobado ? "bg-success" : "bg-danger") fs-6">
                            @Model.Estado.ToString()
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-semibold">Monto Solicitado:</div>
                        <div class="col-sm-8 fs-5 fw-bold text-primary">@Model.MontoSolicitado.ToString("C")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-semibold">Fecha y Hora de Solicitud:</div>
                        <div class="col-sm-8">@Model.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") (UTC: @Model.FechaSolicitud.ToString("yyyy-MM-dd HH:mm"))</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-semibold">Estado Actual:</div>
                        <div class="col-sm-8">
                            <strong id="detalle-estado-texto">@Model.Estado.ToString()</strong>
                        </div>
                    </div>

                    <div id="detalle-motivo-container">
                        @if (Model.Estado == PlataformaCreditos.Models.EstadoSolicitud.Rechazado)
                        {
                            <div class="alert alert-danger mt-3" role="alert">
                                <h6 class="alert-heading fw-bold"><i class="bi bi-x-circle-fill"></i> Motivo del Rechazo:</h6>
                                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.MotivoRechazo) ? "Sin motivo especificado." : Model.MotivoRechazo)</p>
                            </div>
                        }
                    </div>

                    <hr class="my-4" />

                    <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-person-badge"></i> Datos del Cliente Solicitante</h5>
                    
                    @if (Model.Cliente != null)
                    {
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Usuario / Correo:</div>
                            <div class="col-sm-8">@(Model.Cliente.Usuario?.Email ?? "No especificado")</div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Ingresos Mensuales:</div>
                            <div class="col-sm-8 fw-semibold">@Model.Cliente.IngresosMensuales.ToString("C")</div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Límite Aprobación (5x):</div>
                            <div class="col-sm-8 text-secondary">@((Model.Cliente.IngresosMensuales * 5).ToString("C"))</div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted">Estado del Cliente:</div>
                            <div class="col-sm-8">
                                <span class="badge @(Model.Cliente.Activo ? "bg-success" : "bg-danger")">
                                    @(Model.Cliente.Activo ? "Activo" : "Inactivo")
                                </span>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light d-flex justify-content-between py-3">
                    <a asp-action="MisSolicitudes" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver a Mis Solicitudes
                    </a>
                    @if (User.IsInRole("Analista"))
                    {
                        <a asp-controller="Analista" asp-action="Index" class="btn btn-outline-primary">
                            Ir al Panel de Analista
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentSolicitudId = @Model.Id;
            const statusBadge = document.getElementById("ws-status-badge");
            const estadoBadge = document.getElementById("detalle-estado-badge");
            const estadoTexto = document.getElementById("detalle-estado-texto");
            const motivoContainer = document.getElementById("detalle-motivo-container");
            const notificationContainer = document.getElementById("ws-detalle-notification");

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/solicitudes", {
                    transport: signalR.HttpTransportType.WebSockets,
                    skipNegotiation: true
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .build();

            connection.onreconnecting(() => {
                if (statusBadge) {
                    statusBadge.className = "badge bg-warning text-dark";
                    statusBadge.textContent = "Reconectando...";
                }
            });

            connection.onreconnected(() => {
                if (statusBadge) {
                    statusBadge.className = "badge bg-success";
                    statusBadge.textContent = "Conectado";
                }
                // Recuperar estado vigente del servidor tras reconexión
                fetch("/Solicitudes/ObtenerEstadosVigentes")
                    .then(r => r.json())
                    .then(list => {
                        const actual = list.find(s => s.id === currentSolicitudId);
                        if (actual) {
                            actualizarVista(actual.estado, actual.motivoRechazo);
                        }
                    });
            });

            connection.onclose(() => {
                if (statusBadge) {
                    statusBadge.className = "badge bg-danger";
                    statusBadge.textContent = "Desconectado";
                }
            });

            connection.start()
                .then(() => {
                    if (statusBadge) {
                        statusBadge.className = "badge bg-success";
                        statusBadge.textContent = "Conectado";
                    }
                })
                .catch(err => {
                    console.error("Error WebSocket:", err);
                    if (statusBadge) {
                        statusBadge.className = "badge bg-danger";
                        statusBadge.textContent = "Error de Conexión";
                    }
                });

            // Requerimiento: Recibir evento y actualizar sin recargar página
            connection.on("SolicitudEstadoActualizado", function (data) {
                if (data.solicitudId === currentSolicitudId) {
                    actualizarVista(data.estado, data.motivoRechazo);

                    const alertType = data.estado === "Aprobado" ? "success" : "danger";
                    notificationContainer.innerHTML = `
                        <div class="alert alert-${alertType} alert-dismissible fade show shadow mb-3" role="alert">
                            <h5 class="alert-heading mb-1"><i class="bi bi-bell-fill"></i> Actualización de Solicitud</h5>
                            <p class="mb-0">El estado de la solicitud ha cambiado a: <strong>${data.estado}</strong>.</p>
                            ${data.motivoRechazo ? `<small class="d-block mt-1"><strong>Motivo:</strong> ${data.motivoRechazo}</small>` : ''}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>`;
                }
            });

            function actualizarVista(estado, motivoRechazo) {
                if (estadoBadge) {
                    estadoBadge.className = `badge bg-${estado === 'Aprobado' ? 'success' : 'danger'} fs-6`;
                    estadoBadge.textContent = estado;
                }
                if (estadoTexto) {
                    estadoTexto.textContent = estado;
                }
                if (motivoContainer) {
                    if (estado === "Rechazado" && motivoRechazo) {
                        motivoContainer.innerHTML = `
                            <div class="alert alert-danger mt-3" role="alert">
                                <h6 class="alert-heading fw-bold"><i class="bi bi-x-circle-fill"></i> Motivo del Rechazo:</h6>
                                <p class="mb-0">${motivoRechazo}</p>
                            </div>`;
                    } else {
                        motivoContainer.innerHTML = "";
                    }
                }
            }
        });
    </script>
}
