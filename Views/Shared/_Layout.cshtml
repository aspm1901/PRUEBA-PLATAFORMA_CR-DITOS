@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlataformaCreditos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlataformaCreditos.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-custom mb-4 shadow">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="p-1 px-2 rounded bg-emerald text-white me-2 shadow-sm"><i class="bi bi-shield-shaded"></i></span>
                    <span class="fs-5 tracking-wide">CREDI<span class="text-emerald">PRO</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Analista"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-emerald fw-bold" asp-area="" asp-controller="Analista" asp-action="Index">
                                        <i class="bi bi-shield-check"></i> Panel Analista
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Solicitudes" asp-action="MisNotificaciones">
                                        <i class="bi bi-bell"></i> Mis Notificaciones
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Solicitudes" asp-action="MisSolicitudes">
                                        <i class="bi bi-card-checklist"></i> Mis Solicitudes
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Solicitudes" asp-action="Crear">
                                        <i class="bi bi-plus-circle"></i> Nueva Solicitud
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Solicitudes" asp-action="MisNotificaciones">
                                        <i class="bi bi-bell"></i> Mis Notificaciones
                                    </a>
                                </li>
                            }

                            var ultimaId = HttpContextAccessor.HttpContext?.Session?.GetInt32("UltimaSolicitudId");
                            var ultimoMonto = HttpContextAccessor.HttpContext?.Session?.GetString("UltimaSolicitudMonto");
                            if (ultimaId.HasValue && !string.IsNullOrEmpty(ultimoMonto))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-emerald fw-semibold border border-success border-opacity-50 rounded px-2 ms-lg-2 bg-dark bg-opacity-25" 
                                       asp-controller="Solicitudes" asp-action="Detalle" asp-route-id="@ultimaId.Value">
                                        <i class="bi bi-clock-history"></i> Última Solicitud (@ultimoMonto)
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - PlataformaCreditos - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
